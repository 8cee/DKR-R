{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DKR-R Android Mod Catalog",
  "type": "object",
  "required": ["schemaVersion", "mods"],
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string"},
    "mods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "category", "downloadUrl", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "name": {"type": "string"},
          "version": {"type": "string"},
          "category": {"enum": ["translations","textures","characters","tracks","gameplay","ui"]},
          "installTarget": {"enum": ["library","custom-track","texture-pack"]},
          "description": {"type": "string"},
          "author": {"type": "string"},
          "downloadUrl": {"type": "string", "pattern": "^https://"},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "size": {"type": "integer", "minimum": 0, "maximum": 536870912},
          "gameRevisions": {"type": "array", "items": {"enum": ["v77","v80"]}},
          "minAppVersion": {"type": "string"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "conflicts": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
